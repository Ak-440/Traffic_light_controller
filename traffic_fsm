module traffic_fsm (
    input wire clk,
    input wire reset,
    input wire timer_expired,
    output reg red,
    output reg yellow,
    output reg green
);

localparam GREEN  = 2'b00;
localparam YELLOW = 2'b01;
localparam RED    = 2'b10;

reg [1:0] current_state, next_state;

// State memory
always @(posedge clk or posedge reset) begin
    if (reset)
        current_state <= GREEN;
    else if (timer_expired)
        current_state <= next_state;
end

// Next-state logic
always @(*) begin
    case (current_state)
        GREEN:   next_state = YELLOW;
        YELLOW:  next_state = RED;
        RED:     next_state = GREEN;
        default: next_state = GREEN;
    endcase
end

// Output logic
always @(*) begin
    red = 1'b0;
    yellow = 1'b0;
    green = 1'b0;

    case (current_state)
        GREEN:   green = 1'b1;
        YELLOW:  yellow = 1'b1;
        RED:     red = 1'b1;
        default: green = 1'b1;
    endcase
end

endmodule